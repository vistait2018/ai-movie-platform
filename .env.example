# LOCAL DEVELOPMENT ONLY. Copy to .env and replace placeholders.
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=postgresql://movie:replace-local-password@127.0.0.1:5432/movie
APP_REDIS_URL=redis://127.0.0.1:6379/0
APP_READINESS_TIMEOUT_SECONDS=2
POSTGRES_DB=movie
POSTGRES_USER=movie
POSTGRES_PASSWORD=replace-local-password
# Registration abuse guard (development defaults; no credentials)
APP_REGISTRATION_REQUESTS_PER_WINDOW=10
APP_REGISTRATION_WINDOW_SECONDS=60

# Generate a unique key locally; blank disables login safely. Never commit an actual key.
APP_ACCESS_SIGNING_KEY=
APP_ACCESS_TOKEN_SECONDS=600
APP_ACCESS_TOKEN_ISSUER=ai-movie-platform
APP_ACCESS_TOKEN_AUDIENCE=ai-movie-clients
APP_LOGIN_REQUESTS_PER_WINDOW=10
APP_LOGIN_WINDOW_SECONDS=60
