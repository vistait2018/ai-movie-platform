# LOCAL DEVELOPMENT ONLY. Copy to .env and replace placeholders.
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=postgresql://movie:replace-local-password@127.0.0.1:5432/movie
APP_REDIS_URL=redis://127.0.0.1:6379/0
APP_READINESS_TIMEOUT_SECONDS=2
POSTGRES_DB=movie
POSTGRES_USER=movie
POSTGRES_PASSWORD=replace-local-password
